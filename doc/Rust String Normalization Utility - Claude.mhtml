te 2 funzioni:     pub fn parse_name(&amp;self, input: &amp;str) -&gt; Resu=
lt&lt;ParsedName, RitmoErr&gt; {
        if input.split(|c: char| c.is_whitespace() || c =3D=3D '.')
       .filter(|s|!s.is_empty())
       .count() =3D=3D 1 {
            let mut parsed_name =3D ParsedName::default();
            parsed_name.given_name =3D input.trim().to_string();
            parsed_name.display_name =3D input.trim().to_string();
            return Ok(parsed_name);
        }
        let parsed: Name =3D Name::parse(input)
            .ok_or_else(|| NameManagerErrorInternal::NameParsingError(forma=
t!("Impossibile parsificare il nome: '{}'", input)))?;
        let given_name =3D parsed.given_name().unwrap_or("").to_string();
        let surname =3D parsed.surname().to_string();
        let middle_names: Vec&lt;String&gt; =3D parsed.middle_names()
            .map(|names| names.iter().map(|s| s.to_string()).collect())
            .unwrap_or_default();
        let title =3D parsed.honorific_prefix().map(|s| s.to_string());
        let suffix =3D parsed.generational_suffix().map(|s| s.to_string());
        let display_name =3D parsed.display_first_last();
        Ok(ParsedName {
            given_name,
            surname,
            middle_names,
            title,
            suffix,
            display_name: display_name.to_string(),
        })
    }
    pub fn normalize_parsed_name_for_matching(&amp;self, parsed_name: &amp;=
ParsedName) -&gt; String {
        let mut full_name_parts =3D Vec::new();
        if !parsed_name.given_name.is_empty() {
            full_name_parts.push(parsed_name.given_name.as_str());
        }
        for middle_name in &amp;parsed_name.middle_names {
            if !middle_name.is_empty() {
                full_name_parts.push(middle_name.as_str());
