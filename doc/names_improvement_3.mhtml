n class=3D"hljs-keyword">mut</span> NameManager, pool: &amp;SqlitePool) -&g=
t; <span class=3D"hljs-built_in">Result</span>&lt;(), RitmoErr&gt; {
    <span class=3D"hljs-keyword">let</span> names_to_process =3D <span clas=
s=3D"hljs-built_in">vec!</span>[(<span class=3D"hljs-literal">None</span>, =
name_input)]; <span class=3D"hljs-comment">// Nessun ID predefinito, quindi=
 None</span>

    <span class=3D"hljs-comment">// Qui il training ML potrebbe non essere =
necessario per un singolo nome, quindi l'intervallo =C3=A8 alto</span>
    <span class=3D"hljs-keyword">let</span> new_ids_added =3D process_names=
_with_matching_and_ml_training(
        name_manager,
        pool,
        names_to_process,
        <span class=3D"hljs-number">500</span>, <span class=3D"hljs-comment=
">// Continua a chiamare 500 anche se =C3=A8 solo 1 nome, non avr=C3=A0 eff=
etto</span>
        <span class=3D"hljs-number">0</span>,   <span class=3D"hljs-comment=
">// Salva solo alla fine (in questo caso, un solo record)</span>
    ).<span class=3D"hljs-keyword">await</span>?;

    <span class=3D"hljs-keyword">if</span> !new_ids_added.is_empty() {
        <span class=3D"hljs-built_in">println!</span>(<span class=3D"hljs-s=
tring">"Nuovo nome aggiunto con successo! ID: {}"</span>, new_ids_added[<sp=
an class=3D"hljs-number">0</span>]);
    } <span class=3D"hljs-keyword">else</span> {
        <span class=3D"hljs-built_in">println!</span>(<span class=3D"hljs-s=
tring">"Nome gi=C3=A0 esistente o molto simile, non aggiunto come nuovo rec=
ord."</span>);
    }
