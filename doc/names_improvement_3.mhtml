    <span class=3D"hljs-comment">// ... (recupero names_from_file come prim=
a) ...</span>

    <span class=3D"hljs-keyword">let</span> <span class=3D"hljs-keyword">mu=
t</span> name_manager =3D NameManager::new();

    <span class=3D"hljs-keyword">let</span> names_for_processing: <span cla=
ss=3D"hljs-built_in">Vec</span>&lt;(<span class=3D"hljs-built_in">Option</s=
pan>&lt;<span class=3D"hljs-built_in">i64</span>&gt;, <span class=3D"hljs-b=
uilt_in">String</span>)&gt; =3D names_from_file.into_iter()
        .map(|(id, name)| (<span class=3D"hljs-literal">Some</span>(id), na=
me)) <span class=3D"hljs-comment">// Avvolgi l'ID in Some</span>
        .collect();

    <span class=3D"hljs-comment">// Chiama la funzione unificata, passando =
l'intervallo per ML e per il salvataggio DB</span>
    <span class=3D"hljs-keyword">let</span> new_ids_added =3D process_names=
_with_matching_and_ml_training(
        &amp;<span class=3D"hljs-keyword">mut</span> name_manager,
        dst_pool,
        names_for_processing,
        <span class=3D"hljs-number">500</span>, <span class=3D"hljs-comment=
">// Training ML ogni 500 nomi</span>
        <span class=3D"hljs-number">5000</span>, <span class=3D"hljs-commen=
t">// Salva nel DB ogni 5000 record, o 0 per salvare solo alla fine</span>
    ).<span class=3D"hljs-keyword">await</span>?;

    <span class=3D"hljs-comment">// ... (restante logica di logging e final=
izzazione) ...</span>

    <span class=3D"hljs-literal">Ok</span>(())
}

