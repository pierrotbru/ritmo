<span class=3D"hljs-keyword">pub</span> <span class=3D"hljs-keyword">async<=
/span> <span class=3D"hljs-function"><span class=3D"hljs-keyword">fn</span>=
 <span class=3D"hljs-title">add_single_new_name_example</span></span>(name_=
