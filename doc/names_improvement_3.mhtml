span class=3D"hljs-keyword">fn</span> <span class=3D"hljs-title">add_person=
_record</span></span>(&amp;<span class=3D"hljs-keyword">mut</span> <span cl=
ass=3D"hljs-keyword">self</span>, record: PersonRecord) -&gt; <span class=
