lo (e gestisci eventuali conflitti se necessario,</span>
                <span class=3D"hljs-comment">// anche se add_person_record =
dovrebbe gestire l'aggiornamento del max_id)</span>
                id
            } <span class=3D"hljs-keyword">else</span> {
                <span class=3D"hljs-comment">// Se nessun ID =C3=A8 fornito=
, chiedi a NameManager di generarne uno nuovo</span>
                name_manager.generate_next_id()
            };

            <span class=3D"hljs-keyword">let</span> new_record =3D PersonRe=
cord {
                id: record_id,
                original_input: name_input.to_string(),
                normalized_key: name_input.to_lowercase(),
                <span class=3D"hljs-comment">// ... altri campi di PersonRe=
cord</span>
            };

            name_manager.add_person_record(new_record.clone())?;
            new_person_records_to_add_buffer.push(new_record);
            added_ids_this_run.push(record_id);
            final_record_id =3D <span class=3D"hljs-literal">Some</span>(re=
cord_id); <span class=3D"hljs-comment">// Ora =C3=A8 l'ID del nuovo record<=
/span>
        }
        <span class=3D"hljs-comment">// Il `final_record_id` (se Some) ora =
contiene l'ID con cui questo nome =C3=A8 stato gestito</span>
        <span class=3D"hljs-comment">// (sia un match esistente che un nuov=
o record). Utile per logging o debug.</span>
    }

    <span class=3D"hljs-keyword">if</span> !new_person_records_to_add_buffe=
r.is_empty() {
        name_manager.save_person_records_to_db(dst, &amp;new_person_records=
_to_add_buffer).<span class=3D"hljs-keyword">await</span>?;
        new_person_records_to_add_buffer.clear();
    }

    name_manager.train_ml_model()?;

    <span class=3D"hljs-keyword">let</span> elapsed_time =3D start_time.ela=
psed();
    <span class=3D"hljs-built_in">println!</span>(<span class=3D"hljs-strin=
g">"\nProcessamento completato in {:?}"</span>, elapsed_time);
    <span class=3D"hljs-built_in">println!</span>(<span class=3D"hljs-strin=
g">"Totale record aggiunti come nuovi: {}"</span>, added_ids_this_run.len()=
);
    <span class=3D"hljs-built_in">println!</span>(<span class=3D"hljs-strin=
g">"Numero finale di record nel gestore: {}"</span>, name_manager.all_perso=
n_records.len());
    <span class=3D"hljs-built_in">println!</span>(<span class=3D"hljs-strin=
g">"\nApplicazione terminata con successo."</span>);

    <span class=3D"hljs-literal">Ok</span>(added_ids_this_run)
}
